{
  "name": "carlo-tacchella",
  "version": "0.8.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "chart.js": "^4.5.1",
    "react": "^19.2.6",
    "react-chartjs-2": "^5.3.1",
    "react-cookie-consent": "^8.0.1",
    "react-countdown": "^2.3.6",
    "react-dom": "^19.2.6",
    "react-helmet-async": "^1.3.0",
    "react-router-dom": "^6.16.0",
    "react-scripts": "^5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "postbuild": "react-snap",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "reactSnap": {
    "source": "build",
    "fixWebpackChunksIssue": "CRA2",
    "generateSitemap": false,
    "skipThirdPartyRequests": true,
    "waitFor": 3000,
    "navigationTimeout": 30000,
    "minifyHtml": {
      "collapseWhitespace": true,
      "removeComments": true
    },
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox",
      "--disable-dev-shm-usage"
    ],
    "include": [
      "/",
      "/about",
      "/myGithub",
      "/GTSA",
      "/gtsa/privacypolicy",
      "/playStoreUrl",
      "/didattica",
      "/didattica/binario",
      "/didattica/binario/serie01",
      "/didattica/binario/serie02",
      "/didattica/algebrabooleana",
      "/didattica/indirizziip",
      "/didattica/diagrammidiflusso",
      "/didattica/edCivica",
      "/didattica/estrattoredinumeri",
      "/didattica/countdown",
      "/testbench",
      "/testbench/tts",
      "/testbench/stt",
      "/testbench/browserdashboard"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "react-snap": "^1.23.0",
    "typescript": "^4.9.5"
  }
}
