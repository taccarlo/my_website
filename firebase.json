{
  "hosting": {
    "public": "build",
    "rewrites": [
      {
        "source": "/playStoreUrl",
        "destination": "/playStoreUrl.json"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [{
      "source": "**",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}
